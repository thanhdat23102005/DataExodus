{
  "manifest_version": 3,
  "name": "DataExodus Guard",
  "version": "0.5.1",
  "description": "Blocks identifier collection, quarantines ad clicks with an isolated sandbox preview, X-Ray view and private optional AI explanations.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "declarativeNetRequest", "declarativeNetRequestFeedback", "webRequest", "webNavigation"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"},
  "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png"}},
  "options_page": "options.html",
  "web_accessible_resources": [{"resources": ["quarantine.html"], "matches": ["http://*/*", "https://*/*"]}],
  "content_scripts": [
    {"matches": ["http://*/*", "https://*/*"], "js": ["core-main.js", "page.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true},
    {"matches": ["http://*/*", "https://*/*"], "js": ["core.js", "content.js", "xray.js"], "run_at": "document_start", "all_frames": true}
  ]
}
