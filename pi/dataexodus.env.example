# DataExodus Box settings, read by every dataexodus-* service on the Pi.
# pi/install.sh writes /etc/dataexodus/dataexodus.env from this file once and
# never overwrites it. Keep it private (mode 640): it holds the Guard token and
# any API keys. After editing: sudo systemctl restart dataexodus-guard dataexodus-dnswatch
DATAEXODUS_GUARD_TOKEN=__TOKEN__
DATAEXODUS_STATE=/var/lib/dataexodus
DATAEXODUS_HOST_LABEL=__HOST__
BLOCKLIST_DIR=/var/lib/dataexodus/data/blocklists
HOME=/var/lib/dataexodus

# Sandbox browser: Raspberry Pi OS's own Chromium, with Chromium's process sandbox on.
# Slots: concurrent link checks; browse sessions: concurrent Safe Browse visitors.
CHROMIUM_PATH=__CHROMIUM__
DATAEXODUS_CHROMIUM_SANDBOX=1
SANDBOX_SLOTS=2
SANDBOX_BROWSE_SESSIONS=1

# DNS watch. Upstream = auto (the resolver of whichever network the Pi is on,
# from /etc/resolv.conf, else 1.1.1.1), or a fixed one such as 192.168.1.1 or 1.1.1.1.
# Allow = the networks whose devices may use the Pi for DNS (the hotspot is added by itself).
# Mode: observe (log only) or block (listed tracker/malware names get 0.0.0.0).
# Block lists: DataExodus's hand-picked ad/analytics hosts (pi/dns_trackers.txt),
# EasyPrivacy rules that block a whole domain, URLhaus, and your own custom.txt
# (one domain per line). Missing files are skipped.
DNSWATCH_UPSTREAM=auto
DNSWATCH_ALLOW=__ALLOW__
DNSWATCH_MODE=observe
DNSWATCH_DB=/var/lib/dataexodus/dnswatch.sqlite
DNSWATCH_BLOCKLISTS=/opt/dataexodus/pi/dns_trackers.txt,/var/lib/dataexodus/data/blocklists/easyprivacy.txt,/var/lib/dataexodus/data/blocklists/urlhaus_hosts.txt,/var/lib/dataexodus/data/blocklists/custom.txt
DNSWATCH_NEVER_BLOCK=
DNSWATCH_RETENTION_DAYS=7

# DataExodus Wi-Fi and captive portal: written by sudo bash pi/hotspot.sh.
#HOTSPOT_SSID=
#HOTSPOT_PSK=
#PORTAL_NET=10.42.0.0/24
#PORTAL_IP=10.42.0.1
# Hours a hotspot device's lookups are kept (only for devices that opted in).
PORTAL_RETENTION_HOURS=24

# Scheduled study (optional: sudo bash pi/install.sh --study): completed weekly runs kept on the Pi.
STUDY_KEEP_RUNS=8

# Optional, set here on the Pi only (never in chat, never in git):
#GEMINI_API_KEY=
#GEMINI_MODEL=
#WEBRISK_API_KEY=
