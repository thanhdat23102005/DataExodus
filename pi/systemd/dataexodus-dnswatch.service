[Unit]
Description=DataExodus DNS watch (answers only the client networks in DNSWATCH_ALLOW)
Documentation=file:///opt/dataexodus/docs/RASPBERRY_PI.md
After=network-online.target dataexodus-firewall.service
Wants=network-online.target

[Service]
User=dataexodus
Group=dataexodus
WorkingDirectory=/opt/dataexodus
EnvironmentFile=/etc/dataexodus/dataexodus.env
ExecStart=/opt/dataexodus/.venv/bin/python -m pi.dnswatch
Restart=on-failure
RestartSec=5
# Port 53 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
MemoryMax=256M
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/dataexodus
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
