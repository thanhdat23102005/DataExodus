[Unit]
Description=DataExodus Box captive portal (hotspot devices only, http://10.42.0.1)
Documentation=file:///opt/dataexodus/docs/HOTSPOT_VI.md
After=NetworkManager.service dataexodus-guard.service dataexodus-dnswatch.service
Wants=dataexodus-guard.service dataexodus-dnswatch.service
# The hotspot address appears only once the access point is up: keep retrying.
StartLimitIntervalSec=0

[Service]
User=dataexodus
Group=dataexodus
WorkingDirectory=/opt/dataexodus
EnvironmentFile=/etc/dataexodus/dataexodus.env
ExecStart=/opt/dataexodus/.venv/bin/python -m pi.portal
Restart=always
RestartSec=3
# Port 80 on the hotspot address without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
MemoryMax=256M
NoNewPrivileges=yes
ProtectSystem=strict
# Device choices, and deleting a device's lookups ("Forget this device").
ReadWritePaths=/var/lib/dataexodus
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
