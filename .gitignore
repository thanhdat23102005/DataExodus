# DataExodus — Git Ignore

# Sensitive data
/data/identities.local.yaml
/data/.audit-profile-key
/reports/
/data/*.duckdb
/data/*.db
/data/*.db-journal
/data/live/

# Raw outputs (large)
/data/raw/*.json

# Blocklists (downloadable). The contents are excluded rather than the directory
# itself, because git will not descend into an excluded directory and the
# exception below would never be read.
/data/blocklists/*
# ...except my own list: it is measured evidence, not a download.
!/data/blocklists/custom.txt

# Figures
/figures/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.spec

# Virtual env
venv/
.venv/
.env
.env.*
!.env.example
/protection/*.local.json
/guard-browser-profile/
.env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Raspberry Pi box state when run from the project folder
/data/*.sqlite
/data/*.sqlite-*
/data/runs/
/data/study.lock

# Microsoft Office lock files (created while a document is open)
~$*
